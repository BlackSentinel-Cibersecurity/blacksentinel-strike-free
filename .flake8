[flake8]
max-line-length = 120
# Code is auto-formatted with ruff/black. Ignored codes are formatter-managed
# (E203, E501, W503) or low-severity for this offensive-tooling codebase that
# are unsafe to auto-rewrite (E741 short names; F841 locals bound from
# side-effectful run_command()/subprocess calls). All correctness checks
# (undefined names, unused imports, bad comparisons, bare except, ...) stay on.
extend-ignore = E203, E501, E741, W503, F841
exclude = .git,__pycache__,tests,venv
