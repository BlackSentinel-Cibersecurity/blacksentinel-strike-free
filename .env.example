# BlackSentinel Strike - Environment Configuration
# Copyright (c) 2024-2025 BlackSentinel Strike - All Rights Reserved
# Copy to .env and fill in values: cp .env.example .env

# ── Vault ────────────────────────────────────────────────────────
# Master vault password (alternative to interactive prompt)
VAULT_PASSWORD=

# ── SMTP (email notifications) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=blacksentinel-strike@example.com

# ── Webhooks ─────────────────────────────────────────────────────
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── API Keys ─────────────────────────────────────────────────────
SHODAN_API_KEY=
CENSYS_API_KEY=
VIRUSTOTAL_API_KEY=
HUNTERIO_API_KEY=

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=~/.blacksentinel-strike/logs

# ── Stealth / Rate Limiting ──────────────────────────────────────
STEALTH_MODE=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_SECOND=10

# ── Application ──────────────────────────────────────────────────
BLACKSENTINEL_MODE=production
DISPLAY=:0
PYTHONUNBUFFERED=1

# ── Docker (only used in docker-compose) ─────────────────────────
HOST_VAULT_DIR=~/.blacksentinel-strike/vault/scans
